# Copy to .env and fill. Never commit real secrets.

# Supabase (existing project — one for all organizations)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram (legacy Mini App + bot)
BOT_TOKEN=
APP_URL=
SECRET_TOKEN=

# Web (Next.js) — copy SUPABASE_URL / ANON_KEY into apps/web/.env.local as NEXT_PUBLIC_*
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Future web + API
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000
